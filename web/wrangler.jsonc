{
  // Static-assets Worker serving `out/` (next build, output: "export"), now
  // with a custom entrypoint (src/worker.ts) so admin.nullbase.wiki can be
  // routed to the SAME Worker/deploy as nullbase.wiki — see worker.ts.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nullbase",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Serve out/404.html (the app's custom "4xx Client error" page) for
    // unknown paths. html_handling defaults add index.html resolution, so
    // /http -> /http/index.html works without rewrite rules.
    "not_found_handling": "404-page",
    // Every request goes through worker.ts first (needed for the
    // Host-based admin.nullbase.wiki rewrite) instead of the default
    // asset-serves-first behavior.
    "run_worker_first": true
  },
  // Worker Custom Domains (NOT A records). `wrangler deploy` reconciles a
  // Worker's custom domains to exactly match this list — any domain bound
  // in the dashboard but NOT listed here gets removed on the next deploy.
  // nullbase.wiki/www.nullbase.wiki used to be dashboard-only (predating
  // this file) and were silently wiped by every deploy as a result; all
  // three are declared here now so none of them get dropped again, matching
  // api/wrangler.jsonc's pattern for api.nullbase.wiki.
  "routes": [
    {
      "pattern": "nullbase.wiki",
      "custom_domain": true
    },
    {
      "pattern": "www.nullbase.wiki",
      "custom_domain": true
    },
    {
      "pattern": "admin.nullbase.wiki",
      "custom_domain": true
    }
  ]
}
