{
  // API Worker: business logic lives in src/, production data in D1 via the
  // `DB` binding (no credentials — auth is handled entirely by Cloudflare).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nullbase-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nullbase-db",
      "database_id": "4110d1ab-cd1f-44d7-acb1-4a895e093950",
      // Same migration files as the local SQLite runner (npm run db:migrate).
      "migrations_dir": "migrations"
    }
  ],
  // Worker Custom Domain (NOT an A record) — configured in the Cloudflare
  // dashboard zone for nullbase.wiki.
  "routes": [
    {
      "pattern": "api.nullbase.wiki",
      "custom_domain": true
    }
  ],
    "vars": {
    // Comma-separated allowlist (www.nullbase.wiki included for canonical redirects).
    "ALLOWED_ORIGINS": "https://nullbase.wiki,https://www.nullbase.wiki,https://admin.nullbase.wiki"
  }
  // ADMIN_TOKEN_SECRET is a secret, not a var:
  //   npx wrangler secret put ADMIN_TOKEN_SECRET
}