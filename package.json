{
  "name": "nullbase",
  "version": "1.0.0",
  "private": true,
  "description": "nullbase — static developer reference (web) + Cloudflare Worker API (api)",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "dev:all": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web && npm run typecheck -w api",
    "test": "npm run test -w web",
    "deploy:web": "npm run build -w web && cd web && npx wrangler deploy",
    "deploy:api": "cd api && npx wrangler deploy",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:reset": "npm run db:reset -w api",
    "db:admin": "npm run db:admin -w api"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "concurrently": "^9.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true,
    "unrs-resolver@1.12.2": true
  }
}
